# Copy to `.env` and fill in what the entrypoint you are running needs:
#
#   entrypoint                       needs
#   python -m health.seed_demo       nothing
#   python -m health.rebuild_db      nothing
#   python -m health.cli             ANTHROPIC_API_KEY for free-text messages;
#                                    slash commands (/today, /week, ...) need nothing
#   python -m health.main            all three below
#
# `.env` is gitignored. Never commit it.

ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# The one chat the bot will answer. Any other chat is dropped silently — the bot
# refuses to start without this. Send the bot a message and read the id off
# https://api.telegram.org/bot<TOKEN>/getUpdates
ALLOWED_CHAT_ID=

# Routing model (see health/config.py for the default).
# MODEL=

# Where the JSONL system of record and the SQLite projection live (default: ./data).
# DATA_DIR=

# Daily targets. kcal and fat are ceilings, protein and fibre floors, carbs tracked.
# The defaults below are the shipped example values (health/config.py DEFAULT_TARGETS).
# TARGET_KCAL=2200
# TARGET_PROTEIN_G=150
# TARGET_FIBRE_G=28
# TARGET_CARB_G=250
# TARGET_FAT_G=70
